{
    "schema": "https://getcomposer.org/schema.json",
    "name": "jbats3108/the-workout-planner",
    "type": "project",
    "description": "OVRLOAD — workout planning and logging.",
    "keywords": [
        "laravel",
        "inertia",
        "workout"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-data": "^4.17",
        "spatie/laravel-permission": "^6.25",
        "tightenco/ziggy": "^2.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php -r \"if (is_dir('.git') && is_dir('.githooks')) { @mkdir('.git/hooks', 0755, true); foreach (glob('.githooks/*') ?: [] as \\$hook) { if (!is_file(\\$hook)) continue; \\$name = basename(\\$hook); copy(\\$hook, '.git/hooks/' . \\$name); chmod('.git/hooks/' . \\$name, 0755); } }\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "dev:lan": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve --host=0.0.0.0 --port=8000\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev:lan\" --names=server,queue,logs,vite --kill-others"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi"
        ],
        "lint:check": [
            "@php vendor/bin/pint --test --ansi"
        ],
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpstan analyse --memory-limit=2G --ansi"
        ],
        "refactor": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/rector process --ansi"
        ],
        "refactor:dry": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/rector process --dry-run --ansi"
        ],
        "quality": [
            "Composer\\Config::disableProcessTimeout",
            "@lint:check",
            "@analyse"
        ]
    },
    "scripts-descriptions": {
        "lint": "Fix PHP code style with Pint.",
        "lint:check": "Check PHP code style with Pint (no writes).",
        "analyse": "Run PHPStan / Larastan static analysis.",
        "refactor": "Apply Rector refactors.",
        "refactor:dry": "Preview Rector refactors without writing files.",
        "quality": "Run Pint and PHPStan (CI parity)."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
